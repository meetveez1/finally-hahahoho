# Keep project files as text with normalized LF endings.
* text=auto

# Flutter / Android source and config should stay LF on all platforms.
*.dart text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.lock text eol=lf

# Extra explicit rules for files that often cause CRLF noise/conflicts on Windows.
pubspec.lock text eol=lf
android/gradle/wrapper/gradle-wrapper.properties text eol=lf
android/gradle.properties text eol=lf
android/settings.gradle text eol=lf

# Common binary assets and Android artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary
*.so binary
*.aar binary
*.jar binary
*.aab binary
*.apk binary
